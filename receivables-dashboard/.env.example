# Copy to .env and fill in your values:  cp .env.example .env

# Required: Anthropic API key
ANTHROPIC_API_KEY=your-anthropic-api-key-here


# Optional overrides (can also be passed as CLI args).
# TALLY_URL points at the Tally Gateway, NOT the MCP server. The Gateway runs
# on the same laptop as TallyPrime, so localhost:9000 is correct in this setup.
# (The cloudflared tunnel https://tally.tallymcpclient.com fronts the MCP
# server on port 8000, which is a different thing.)
TALLY_URL=http://localhost:9000
LEDGER_GROUP=Sundry Debtors
GMAIL_SENDER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
UPI_VPA=your-upi-id@bank